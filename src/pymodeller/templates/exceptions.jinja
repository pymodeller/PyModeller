"""AUTO-GENERATED EXCEPTIONS."""


class BaseCustomError(Exception):
    """Base custom exception."""

    def __init__(
        self,
        message: str = "General exception.",
        code: str | int = "GENERAL_ERROR",
        description: str = "General exception raised.",
    ) -> None:
        """Initialize exception."""
        super().__init__(message)
        self.message = message
        self.code = code
        self.description = description


{% for exc in exceptions | sort(attribute='class_name') %}
class {{ exc.class_name }}Error(BaseCustomError):
    """{{ exc.description }}"""

    def __init__(
        self,
        message: str = "{{ exc.detail }}",
        code: str | int = "{{ exc.code }}",
        description: str = "{{ exc.description }}",
    ) -> None:
        """Initialize exception."""
        super().__init__(
            message=message,
            code=code,
            description=description,
        )


{% endfor %}